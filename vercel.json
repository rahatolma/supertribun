{
  "rewrites": [
    { "source": "/t/:id", "destination": "/api/share?id=:id" },
    { "source": "/auth/challenge", "destination": "/index.html" },
    { "source": "/onizleme", "destination": "/index.html" },
    { "source": "/uyelik-kosullari", "destination": "/index.html" },
    { "source": "/gizlilik", "destination": "/index.html" },
    { "source": "/topluluk-kurallari", "destination": "/index.html" },
    { "source": "/puanlama-ve-oyun-kurallari", "destination": "/index.html" },
    { "source": "/cerez-politikasi", "destination": "/index.html" },
    { "source": "/hesap-silme", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/auth/challenge",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
